# =============================================================================
# Landlord-Tenant Direct Connect Platform - Environment Variables Template
# =============================================================================
# Copy this file to `.env` and fill in your real values for local development.
# The `.env` file is git-ignored and MUST NEVER be committed.
# Never commit real secrets, passwords or credentials.
# =============================================================================

# --- Django core ---
# DEBUG: development=True, production=False
DEBUG=True

# SECRET_KEY: generate a strong random value in production, e.g. from Python:
#   from django.core.management.utils import get_random_secret_key
#   print(get_random_secret_key())
SECRET_KEY=

# ALLOWED_HOSTS: comma-separated list of hostnames allowed to serve the app.
# Development default is fine; production must list your real domain(s).
ALLOWED_HOSTS=127.0.0.1,localhost

# CSRF trusted origins for production (comma-separated https origins), e.g.:
# https://yourdomain.com
CSRF_TRUSTED_ORIGINS=

# --- Database (PostgreSQL) ---
# Local development default database name.
DATABASE_NAME=landlord_tenant_db
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# --- Production security overrides (only set these in production) ---
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# =============================================================================
# Landlord-Tenant Direct Connect Platform - Environment Variables Template
# =============================================================================
# Copy this file to `.env` and fill in your real values for local development.
# The `.env` file is git-ignored and MUST NEVER be committed.
# Never commit real secrets, passwords or credentials.
# =============================================================================

# --- Django core ---
# DEBUG: development=True, production=False
DEBUG=True

# DJANGO_SETTINGS_MODULE: only needed in production.
# Development default is config.settings (loaded via settings/__init__.py).
# Production MUST set: config.settings.production
# DJANGO_SETTINGS_MODULE=config.settings.production

# SECRET_KEY: generate a strong random value in production, e.g. from Python:
#   from django.core.management.utils import get_random_secret_key
#   print(get_random_secret_key())
SECRET_KEY=

# ALLOWED_HOSTS: comma-separated list of hostnames allowed to serve the app.
# Development default is fine; production must list your real domain(s).
ALLOWED_HOSTS=127.0.0.1,localhost

# CSRF trusted origins for production (comma-separated https origins), e.g.:
# https://yourdomain.com
CSRF_TRUSTED_ORIGINS=

# --- Database (PostgreSQL) ---
# Local development default database name.
DATABASE_NAME=landlord_tenant_db
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# Render (and similar platforms) provide a single DATABASE_URL.
# When set, it takes precedence over the individual DATABASE_* vars above.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=

# --- Production security overrides (only set these in production) ---
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# --- Email (production; optional -- no email feature is currently shipped) ---
# Production must NOT use Django's development console backend. These values
# are read from the environment only; never hard-code credentials.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- Cloudinary (production media storage) ---
# Required for production on Render where the local filesystem is ephemeral.
# Sign up at https://cloudinary.com (free tier: 25 GB storage).
# The CLOUDINARY_URL is auto-generated by Cloudinary and contains all
# connection details.  Format:
#   cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# When not set, media files use the local file system (development default).
# CLOUDINARY_URL=
